NEXT_PUBLIC_SITE_URL=https://www.smestack.my
# Optional. Leave blank until a Plausible site is configured.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Inbox that receives paid review requests. Use the mailbox you actually check.
NEXT_PUBLIC_LEAD_INBOX=

# Required to open the paid-review form in production.
REVIEW_INBOX=
REVIEW_FROM_EMAIL=SME Stack <reviews@your-verified-domain.my>
RESEND_API_KEY=

# Optional HTTPS referral / affiliate URLs. Blank = official vendor site.
NEXT_PUBLIC_REFERRAL_AUTOCOUNT=
NEXT_PUBLIC_REFERRAL_BUKKU=
NEXT_PUBLIC_REFERRAL_PAYROLLPANDA=
NEXT_PUBLIC_REFERRAL_SQL_ACCOUNT=
NEXT_PUBLIC_REFERRAL_QNE=
NEXT_PUBLIC_REFERRAL_XERO=
NEXT_PUBLIC_REFERRAL_STOREHUB=
NEXT_PUBLIC_REFERRAL_EASYSTORE=
NEXT_PUBLIC_REFERRAL_KAKITANGAN=
NEXT_PUBLIC_REFERRAL_FINANCIO=
